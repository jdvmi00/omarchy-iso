          "product_name": "Surface Laptop 13.8in 8th Ed Snapdragon"
        }
      ],
      "boot": {
        "hardware_description": "dtb-override",
        "dtb": "qcom/glymur-microsoft-surface-laptop8.dtb",
        "kernel_cmdline": [
