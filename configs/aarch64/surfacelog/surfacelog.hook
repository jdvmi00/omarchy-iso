#!/usr/bin/ash
# surfacelog: write dmesg/state to the ARCHISO_EFI FAT partition every 3 s, before and
# after switch_root (loop in /run/surfacelog-rt with relative paths + own busybox/ld.so
# copies, since switch_root wipes the initramfs we stay rooted in). Never fails the boot.

_sl_rt=/run/surfacelog-rt
_sl_mnt=/run/surfacelog

_sl_log() {
    echo "surfacelog: $*" >/dev/kmsg 2>/dev/null
    msg ":: surfacelog: $*" 2>/dev/null
    echo "surfacelog: $*" >>"$_sl_rt/surfacelog.log" 2>/dev/null
    return 0
}

_sl_up() {
    local up rest
    read -r up rest 2>/dev/null </proc/uptime || up='?'
    printf '%s' "$up"
}

_sl_dir() {
    local n=''
    read -r n 2>/dev/null <"$_sl_rt/bootnum"
    case "$n" in ''|*[!0-9]*) return 0 ;; esac
    [ -d "$_sl_mnt/boot-$n" ] && printf '%s' "$_sl_mnt/boot-$n"
    return 0
}

_sl_prepare_rt() {
    local bb=/usr/bin/busybox ld='' p f
    mkdir -p "$_sl_rt/lib" "$_sl_mnt" 2>/dev/null
    [ -f "$bb" ] || bb=/bin/busybox
    cp "$bb" "$_sl_rt/busybox" 2>/dev/null
    for p in /usr/lib/ld-*.so* /lib/ld-*.so* /lib64/ld-*.so*; do
        [ -f "$p" ] && { ld="$p"; break; }
    done
    if [ -z "$ld" ]; then
        _sl_log "no dynamic loader found; loop will die at switch_root"
        return 0
    fi
    cp "$ld" "$_sl_rt/ld.so" 2>/dev/null
    for p in /usr/bin/mount /usr/bin/blkid; do
        [ -f "$p" ] && cp "$p" "$_sl_rt/${p##*/}" 2>/dev/null
    done
    chmod 755 "$_sl_rt"/* 2>/dev/null
    for p in "$bb" "$_sl_rt/mount" "$_sl_rt/blkid"; do
        [ -f "$p" ] || continue
        "$ld" --list "$p" 2>/dev/null | awk '$2 == "=>" && $3 ~ /^\// { print $3 }' | while read -r f; do
            [ -e "$_sl_rt/lib/${f##*/}" ] || cp "$f" "$_sl_rt/lib/${f##*/}" 2>/dev/null
        done
    done
    if "$_sl_rt/ld.so" --library-path "$_sl_rt/lib" "$_sl_rt/busybox" true 2>/dev/null; then
        _sl_log "runtime copies ready in $_sl_rt (loader $ld)"
    else
        _sl_log "self-contained runtime failed (loader $ld); loop will die at switch_root"
        rm -f "$_sl_rt/ld.so" 2>/dev/null
    fi
    return 0
}

_sl_write_loop() {
    cat >"$_sl_rt/loop.sh" <<'EOF'
#!/usr/bin/ash
# surfacelog loop: loop.sh loop|show [DEV START REBOOT WDT]; cwd fixed, relative paths only
mode="$1" dev="$2" start="${3:-0}" rb="${4:-0}" wdt="${5:-0}"
cd /run/surfacelog-rt || exit 0
ROOT=../.. MNT=../surfacelog NULL=./null LOGD='' round=0 d='' how='' found=''
# watchdog first: opening arms it; a failed exec-redirect would kill the shell, so probe in a subshell
if [ "$wdt" = 1 ] && [ -w "$ROOT/dev/watchdog" ] && ( exec 8>"$ROOT/dev/watchdog" ) 2>"$NULL"; then
    exec 8>"$ROOT/dev/watchdog"
else
    wdt=0
fi
if [ -x ./ld.so ] && [ -x ./busybox ]; then
    bb() { ./ld.so --library-path ./lib ./busybox "$@"; }
    do_mount() { ./ld.so --library-path ./lib ./mount "$@"; }
    do_blkid() { ./ld.so --library-path ./lib ./blkid "$@"; }
else
    bb() { busybox "$@"; }
    do_mount() { mount "$@"; }
    do_blkid() { blkid "$@"; }
fi
if [ -c "$ROOT/dev/kmsg" ]; then exec 9>"$ROOT/dev/kmsg"; else exec 9>"$NULL"; fi
log() {
    printf 'loop: %s\n' "$*" >&2
    printf 'surfacelog: %s\n' "$*" >&9 2>"$NULL"
}
[ "$wdt" = 1 ] && log "watchdog armed (30 s), feeding every 3 s"
[ -p ./sleep.fifo ] || bb mkfifo ./sleep.fifo 2>"$NULL"
[ -p ./sleep.fifo ] && exec 3<>./sleep.fifo
nap() {
    bb sleep "$1" 2>"$NULL" && return 0
    [ -p ./sleep.fifo ] && { read -r -t "$1" _ 2>"$NULL" <&3; return 0; }
    log "no way to sleep, exiting"; exit 0
}
is_mounted() { bb mountpoint -q "$MNT" 2>"$NULL"; }
is_efi() {
    case "$(do_blkid -p -o export "$1" 2>"$NULL")" in *LABEL=ARCHISO_EFI*|*TYPE=vfat*) return 0 ;; esac
    return 1
}
find_dev() {
    local c s m rest b
    d=''
    for c in "${dev:+$ROOT$dev}" "$ROOT/dev/disk/by-label/ARCHISO_EFI"; do
        [ -n "$c" ] && [ -b "$c" ] && { d="$c" how="by-label/$dev"; return 0; }
    done
    s="$(while read -r c m rest; do [ "$m" = /run/archiso/bootmnt ] && { echo "$c"; break; }; done <"$ROOT/proc/1/mounts" 2>"$NULL")"
    b="$s"
    if [ -n "$b" ]; then
        while case "$b" in *[0-9]) : ;; *) false ;; esac; do b="${b%[0-9]}"; done
        case "$b" in *[0-9]p) b="${b%p}" ;; esac
        case "$b" in *[0-9]) b="${b}p2" ;; *) b="${b}2" ;; esac
        if [ -b "$ROOT$b" ] && is_efi "$ROOT$b"; then d="$ROOT$b" how="partition 2 of archiso bootmnt device $s"; return 0; fi
        log "bootmnt device $s -> $b: not a usable vfat partition"
    fi
    for c in "$ROOT"/dev/sd?2; do
        [ -b "$c" ] && is_efi "$c" && { d="$c" how="scan of /dev/sd?2 (${c#$ROOT})"; return 0; }
    done
    return 1
}
try_mount() {
    local err rc
    is_mounted && return 0
    if ! find_dev; then
        [ $((round % 2)) -eq 1 ] && log "no ARCHISO_EFI yet; by-label: $(echo $(bb ls "$ROOT/dev/disk/by-label" 2>&1)) sd?2: $(echo "$ROOT"/dev/sd?2) bootmnt mounted: $(bb grep -c bootmnt "$ROOT/proc/1/mounts" 2>"$NULL")"
        return 1
    fi
    err="$(do_mount -c -t vfat -o rw,noatime,flush "$d" "$MNT" 2>&1)"; rc=$?
    log "mount -c -t vfat -o rw,noatime,flush $d $MNT ($how) -> rc=$rc $err"
    [ "$rc" -eq 0 ] || return 1
    found="$how"
    return 0
}
setup_dir() {
    local n='' bn='' f
    [ -n "$LOGD" ] && [ -d "$LOGD" ] && return 0
    is_mounted || return 1
    read -r bn 2>"$NULL" <./bootnum
    case "$bn" in ''|*[!0-9]*) bn='' ;; esac
    if [ -n "$bn" ] && [ -d "$MNT/boot-$bn" ]; then LOGD="$MNT/boot-$bn"; return 0; fi
    read -r n 2>"$NULL" <"$MNT/boot-count"
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1))
    printf '%s\n' "$n" >"$MNT/boot-count" 2>"$NULL"
    bb mkdir -p "$MNT/boot-$n" 2>"$NULL" || { log "mkdir $MNT/boot-$n failed"; return 1; }
    LOGD="$MNT/boot-$n"
    printf '%s\n' "$n" >./bootnum
    {
        printf 'surfacelog boot #%s\nlog partition: %s\n== /proc/version\n' "$n" "${found:-$how}"
        bb cat "$ROOT/proc/version"; printf '== /proc/cmdline\n'; bb cat "$ROOT/proc/cmdline"
    } >"$LOGD/info.txt" 2>&1
    for f in ./pstore/*; do [ -f "$f" ] && bb cp "$f" "$LOGD/pstore-${f##*/}" 2>"$NULL"; done
    log "created $LOGD (boot #$n), logging there"
    return 0
}
do_round() {
    local up='' rest p1=''
    round=$((round + 1))
    [ "$wdt" = 1 ] && printf . >&8 2>"$NULL"
    read -r up rest 2>"$NULL" <"$ROOT/proc/uptime" || up='?'
    read -r p1 2>"$NULL" <"$ROOT/proc/1/comm" || p1='?'
    setup_dir || { try_mount && setup_dir; }
    if [ -z "$LOGD" ]; then
        if [ "$rb" -gt 0 ] && [ "${up%.*}" -ge $((start + rb - 3)) ] 2>"$NULL"; then
            log "no log device after $rb s, rebooting to preserve ramoops"
            bb sync 2>"$NULL"; nap 3; rb=0 wdt=0
            echo 1 >"$ROOT/proc/sys/kernel/sysrq"
            echo b >"$ROOT/proc/sysrq-trigger"
        fi
        return 0
    fi
    if bb dmesg >"$LOGD/dmesg.txt.new" 2>&1 && bb mv -f "$LOGD/dmesg.txt.new" "$LOGD/dmesg.txt" 2>"$NULL"; then
        [ "$round" -le 3 ] || [ $((round % 10)) -eq 0 ] && log "round $round: wrote $LOGD/dmesg.txt (uptime $up pid1=$p1)"
    else
        log "round $round: dmesg write failed"
    fi
    printf 'round %s uptime %s pid1=%s\n' "$round" "$up" "$p1" >>"$LOGD/heartbeat.txt" 2>"$NULL"
    {
        printf '== round %s uptime %s pid1=%s\n== ls -l /dev/disk/by-label /dev/disk/by-id\n' "$round" "$up" "$p1"
        bb ls -l "$ROOT/dev/disk/by-label" "$ROOT/dev/disk/by-id" 2>"$NULL"
        printf '== /proc/modules\n'; bb cat "$ROOT/proc/modules"
        printf '== /sys/bus/platform/drivers\n'; bb ls "$ROOT/sys/bus/platform/drivers"
        printf '== /proc/1/mounts\n'; bb cat "$ROOT/proc/1/mounts"
    } >"$LOGD/state.txt.new" 2>&1 && bb mv -f "$LOGD/state.txt.new" "$LOGD/state.txt" 2>"$NULL"
    [ -s ./surfacelog.log ] && bb cp ./surfacelog.log "$LOGD/surfacelog.log" 2>"$NULL"
    bb sync 2>"$NULL"
    return 0
}
# page the previous boot's console-ramoops to stdout (/dev/console)
show() {
    local f n t p a b
    for f in ./pstore/console-ramoops*; do [ -f "$f" ] && break; done
    [ -f "$f" ] || exit 0
    bb tac "$f" | bb grep -iE 'surfacelog|dwc3|xhci|usb|phy|dp_|drm|msm|panel|edp|error|fail|timeout|-110|-517' | bb awk '!s[$0]++' | bb head -n 50 | bb tac >./sum.txt
    bb tail -n 1200 "$f" >./show.txt
    n=$(bb wc -l <./show.txt); t=$(( (n + 49) / 50 )); p=0
    printf '=== surfacelog: previous boot console log, summary: last %s distinct matching lines, most recent last; %s pages of the last %s lines follow, 12 s each ===\n' "$(bb wc -l <./sum.txt)" "$t" "$n"
    bb cat ./sum.txt
    while [ "$p" -lt "$t" ]; do
        nap 12; p=$((p + 1)); a=$(( (p - 1) * 50 + 1 )); b=$((p * 50)); [ "$b" -gt "$n" ] && b=$n
        printf '=== surfacelog: previous boot console log, page %s/%s (lines %s-%s of %s) ===\n' "$p" "$t" "$a" "$b" "$n"
        bb sed -n "${a},${b}p" ./show.txt
    done
}
case "$mode" in
    show) show ;;
    loop)
        trap '' HUP PIPE
        log "background loop started (pid $$)"
        while :; do do_round; nap 3; done ;;
esac
exit 0
EOF
    chmod 755 "$_sl_rt/loop.sh" 2>/dev/null
    return 0
}

# stage previous-boot pstore files; with surfacelog_show=1 page them to the console
_sl_pstore() {
    local f n=0
    mount -t pstore pstore /sys/fs/pstore 2>/dev/null
    mkdir -p "$_sl_rt/pstore" 2>/dev/null
    for f in /sys/fs/pstore/console-ramoops* /sys/fs/pstore/dmesg-ramoops*; do
        [ -f "$f" ] && n=$((n + 1))
    done
    cp /sys/fs/pstore/* "$_sl_rt/pstore/" 2>/dev/null
    _sl_log "pstore: $n console/dmesg ramoops files"
    [ "$(getarg surfacelog_show)" = 1 ] || return 0
    if [ "$n" -eq 0 ]; then
        echo "surfacelog: surfacelog_show=1 but /sys/fs/pstore has no console-ramoops/dmesg-ramoops files" >/dev/console 2>/dev/null
        _sl_log "surfacelog_show=1 but pstore is empty"
        return 0
    fi
    chmod 644 /hooks/plymouth 2>/dev/null
    ash "$_sl_rt/loop.sh" show </dev/null >/dev/console 2>>"$_sl_rt/surfacelog.log" &
    _sl_log "paging previous console log to /dev/console (pid $!, plymouth hook disabled)"
    return 0
}

_sl_start_loop() {
    local pid='' o
    o="$(getarg surfacelog_dev 2>/dev/null)"
    [ -b "$o" ] || o=''
    set -- "$_sl_rt/loop.sh" loop "$o" "${_sl_start%.*}" "$_sl_rb" "$_sl_wdt"
    if command -v setsid >/dev/null 2>&1; then
        setsid ash "$@" </dev/null >>"$_sl_rt/surfacelog.log" 2>&1 &
    else
        ash "$@" </dev/null >>"$_sl_rt/surfacelog.log" 2>&1 &
    fi
    pid=$!
    printf '%s\n' "$pid" >"$_sl_rt/loop.pid" 2>/dev/null
    _sl_log "background loop pid $pid started (uptime $(_sl_up)); dev '$o', reboot-if-unmounted ${_sl_rb}s, wdt $_sl_wdt"
    return 0
}

# foreground: give the loop up to surfacelog_wait s (default 25, capped by surfacelog_reboot) to mount
_sl_wait() {
    local i=0 w
    w="$(getarg surfacelog_wait 25 2>/dev/null)"
    case "$w" in ''|*[!0-9]*) w=25 ;; esac
    [ "$_sl_rb" -gt 0 ] && [ "$_sl_rb" -lt "$w" ] && w=$_sl_rb
    while [ "$i" -lt $((w * 2)) ] && [ ! -f "$_sl_rt/bootnum" ]; do
        sleep 0.5 2>/dev/null || sleep 1
        i=$((i + 1))
    done
    _sl_log "foreground wait ended after $((i / 2)) s, log dir '$(_sl_dir)'"
    return 0
}

_sl_marker() {
    local dir
    dir="$(_sl_dir)"
    _sl_log "$1 (uptime $(_sl_up), log dir '$dir')"
    [ -n "$dir" ] || return 0
    printf '%s (uptime %s)\n' "$1" "$(_sl_up)" >>"$dir/markers.txt" 2>/dev/null
    dmesg >"$dir/$2" 2>/dev/null
    cat /proc/self/mounts >"$dir/mounts-${2#dmesg-}" 2>/dev/null
    sync 2>/dev/null
    return 0
}

run_hook() {
    mkdir -p "$_sl_rt" "$_sl_mnt" 2>/dev/null
    {
        _sl_start="$(_sl_up)"
        _sl_rb="$(getarg surfacelog_reboot 0 2>/dev/null)"
        case "$_sl_rb" in ''|*[!0-9]*) _sl_rb=0 ;; esac
        _sl_wdt="$(getarg surfacelog_wdt 0 2>/dev/null)"
        _sl_log "hook start (uptime $_sl_start); /run/udev $([ -d /run/udev ] && echo exists || echo absent); /dev/watchdog $([ -c /dev/watchdog ] && echo present || echo absent)"
        [ "$_sl_wdt" = 1 ] && [ ! -c /dev/watchdog ] && _sl_log "no /dev/watchdog"
        _sl_prepare_rt
        _sl_write_loop
        _sl_pstore
        _sl_start_loop
        modprobe -qab vfat nls_cp437 nls_ascii nls_utf8 2>/dev/null
        _sl_log "vfat in /proc/filesystems: $(grep -c vfat /proc/filesystems 2>/dev/null)"
        _sl_wait
    } 2>>"$_sl_rt/surfacelog.log" || :
    return 0
}

run_latehook() {
    _sl_marker "switch_root about to happen" dmesg-pre-switch_root.txt || :
    return 0
}

run_emergencyhook() {
    _sl_marker "emergency shell" dmesg-emergency.txt || :
    return 0
}
